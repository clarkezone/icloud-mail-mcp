[
  {
    "name": "list_folders",
    "description": "List iCloud folders read-only. Counts are optional live observations. Prefix is literal; continue with identical prefix/options.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "cursor": {
          "maxLength": 2048,
          "type": [
            "string",
            "null"
          ]
        },
        "include_counts": {
          "default": false,
          "type": "boolean"
        },
        "page_size": {
          "default": 50,
          "format": "uint",
          "maximum": 100,
          "minimum": 1,
          "type": "integer"
        },
        "prefix": {
          "default": "",
          "maxLength": 1024,
          "type": "string"
        }
      },
      "title": "ListFolders",
      "type": "object"
    },
    "outputSchema": {
      "$defs": {
        "Folder": {
          "properties": {
            "counts_observed_at": {
              "type": [
                "string",
                "null"
              ]
            },
            "delimiter": {
              "type": [
                "string",
                "null"
              ]
            },
            "folder_handle": {
              "type": "string"
            },
            "message_count": {
              "format": "uint32",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "name": {
              "type": "string"
            },
            "roles": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "selectable": {
              "type": "boolean"
            },
            "unread_count": {
              "format": "uint32",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            }
          },
          "required": [
            "folder_handle",
            "name",
            "selectable",
            "roles"
          ],
          "type": "object"
        }
      },
      "anyOf": [
        {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "properties": {
            "folders": {
              "items": {
                "$ref": "#/$defs/Folder"
              },
              "type": "array"
            },
            "next_cursor": {
              "type": [
                "string",
                "null"
              ]
            },
            "snapshot_created_at": {
              "type": "string"
            }
          },
          "required": [
            "folders",
            "snapshot_created_at"
          ],
          "title": "FolderPage",
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "error": {
              "additionalProperties": false,
              "properties": {
                "code": {
                  "enum": [
                    "configuration_error",
                    "authentication_failed",
                    "tls_error",
                    "upstream_unavailable",
                    "mailbox_not_found",
                    "message_not_found",
                    "stale_reference",
                    "cursor_expired",
                    "invalid_cursor",
                    "unsupported_search",
                    "unsupported_content",
                    "size_limit",
                    "busy",
                    "deadline_exceeded",
                    "cancelled",
                    "internal_error"
                  ],
                  "type": "string"
                },
                "retry_after_ms": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "retryable": {
                  "type": "boolean"
                }
              },
              "required": [
                "code",
                "retryable",
                "retry_after_ms"
              ],
              "type": "object"
            }
          },
          "required": [
            "error"
          ],
          "type": "object"
        }
      ],
      "type": "object"
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": true
    }
  },
